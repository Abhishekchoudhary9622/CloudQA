# LLM Provider configuration: 'heuristic' (offline, zero API keys required), 'gemini', or 'openai'
LLM_PROVIDER=heuristic

# Optional API keys for AI planning
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Browser execution options
HEADLESS=true
BROWSER_TIMEOUT=20000

# Web UI Server port
PORT=3000

