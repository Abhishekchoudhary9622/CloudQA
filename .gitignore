# Environment secrets
.env
**/.env

# Keep example configurations public
!.env.example
!**/.env.example

# Dependencies and build files
**/node_modules/
**/bin/
**/obj/
**/dist/
**/out/

# IDE and Editor caches
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Transient test output (preserve directory structure via .gitkeep)
Screenshots/*
!Screenshots/.gitkeep
Reports/*
!Reports/.gitkeep
screenshots/*
!screenshots/.gitkeep
reports/*
!reports/.gitkeep
